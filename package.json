{
  "name": "wdio-cucumber-healthcare-automation",
  "version": "2.0.0",
  "description": "Enterprise Healthcare Clinical Operations & Telehealth E2E Test Automation Framework powered by WebdriverIO, Cucumber BDD, TypeScript, and AI Agentic Testing.",
  "author": "Aman Patwal <amanpatwalfor@gmail.com> (https://github.com/APdrone)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node app/server.js",
    "app": "node app/server.js",
    "test": "node scripts/run-e2e.js",
    "test:smoke": "node scripts/run-e2e.js --cucumberOpts.tags=\"@smoke\"",
    "test:regression": "node scripts/run-e2e.js --cucumberOpts.tags=\"@regression\"",
    "test:a11y": "node scripts/run-e2e.js --spec features/06_resilience_and_a11y.feature",
    "test:agent": "node scripts/run-e2e.js --spec features/05_agentic_ai_triage.feature",
    "agent:debug": "wdio run config/wdio.conf.ts --debug=agent",
    "report": "node -e \"const { exec } = require('child_process'); exec('start reports/medpulse-e2e-report.html')\"",
    "report:html": "node scripts/generate-dashboard.js",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@wdio/allure-reporter": "^9.5.0",
    "@wdio/cli": "^9.5.0",
    "@wdio/cucumber-framework": "^9.5.0",
    "@wdio/local-runner": "^9.5.0",
    "@wdio/spec-reporter": "^9.5.0",
    "@wdio/types": "^9.5.0",
    "allure-commandline": "^2.32.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
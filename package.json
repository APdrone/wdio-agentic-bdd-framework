{
  "name": "wdio-cucumber-healthcare-automation",
  "version": "2.0.0",
  "description": "Enterprise Healthcare Clinical Operations & Telehealth E2E Test Automation Framework powered by WebdriverIO, Cucumber BDD, TypeScript, and AI Agentic Testing.",
  "author": "Aman Patwal <amanpatwalfor@gmail.com> (https://github.com/APdrone)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node app/server.js",
    "app": "node app/server.js",
    "test": "node scripts/run-e2e.js",
    "test:local": "wdio run config/wdio.conf.ts",
    "test:headless": "wdio run config/wdio.headless.conf.ts",
    "test:smoke": "wdio run config/wdio.headless.conf.ts --cucumberOpts.tags=\"@smoke\"",
    "test:regression": "wdio run config/wdio.headless.conf.ts --cucumberOpts.tags=\"@regression\"",
    "test:agent": "wdio run config/wdio.agent.conf.ts",
    "agent:debug": "wdio run config/wdio.conf.ts --debug=agent",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@wdio/allure-reporter": "^9.5.0",
    "@wdio/cli": "^9.5.0",
    "@wdio/cucumber-framework": "^9.5.0",
    "@wdio/local-runner": "^9.5.0",
    "@wdio/spec-reporter": "^9.5.0",
    "@wdio/types": "^9.5.0",
    "allure-commandline": "^2.32.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}